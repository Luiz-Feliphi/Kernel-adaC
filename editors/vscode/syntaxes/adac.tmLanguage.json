{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "adaC",
  "scopeName": "source.adac",
  "fileTypes": [
    "adac"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#use-declaration"
    },
    {
      "include": "#import-declaration"
    },
    {
      "include": "#for-header"
    },
    {
      "include": "#class-declaration"
    },
    {
      "include": "#builtin-functions"
    },
    {
      "include": "#intrinsics"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#library-types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#member-access"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#function-call"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.adac",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.adac"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.adac"
            }
          }
        },
        {
          "name": "comment.line.double-slash.adac",
          "match": "(//).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.adac"
            }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.adac",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.adac"
        }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.adac"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.unicode.adac",
          "match": "\\\\U[0-9a-fA-F]{8}"
        },
        {
          "name": "constant.character.escape.unicode.adac",
          "match": "\\\\u[0-9a-fA-F]{4}"
        },
        {
          "name": "constant.character.escape.adac",
          "match": "\\\\(?:[nrt0abfv\\\\\\'\""]|x[0-9a-fA-F]{1,2})"
        },
        {
          "name": "constant.other.placeholder.adac",
          "match": "%[-+ 0#]*\\d*(?:\\.\\d+)?[lhz]*[dfscxXpiub%]"
        },
        {
          "name": "invalid.illegal.escape.adac",
          "match": "\\\\."
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.adac",
      "match": "'(?:[^'\\\\\\n]|\\\\(?:[nrt0abfv\\\\\\'\""]|x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8}))'"
    },
    "directives": {
      "match": "(#)(NOT_GARBAGE|NOT_GARGBAGE|STRICT|strict|definePackage|definePackege)\\b",
      "name": "meta.preprocessor.adac",
      "captures": {
        "1": {
          "name": "punctuation.definition.directive.adac"
        },
        "2": {
          "name": "keyword.control.directive.adac"
        }
      }
    },
    "use-declaration": {
      "begin": "^\\s*(use)\\b(?=\\s+[A-Za-z_])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.adac"
        }
      },
      "end": ";",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.statement.adac"
        }
      },
      "patterns": [
        {
          "name": "punctuation.separator.namespace.adac",
          "match": "::"
        },
        {
          "name": "keyword.operator.wildcard.adac",
          "match": "\\*"
        },
        {
          "name": "entity.name.namespace.adac",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "import-declaration": {
      "patterns": [
        {
          "comment": "import with module path: import std::pc; or import std.pc; or import mylib;",
          "begin": "^\\s*(import)\\b(?=\\s+[A-Za-z_])",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.adac"
            }
          },
          "end": ";",
          "endCaptures": {
            "0": {
              "name": "punctuation.terminator.statement.adac"
            }
          },
          "patterns": [
            {
              "name": "punctuation.separator.namespace.adac",
              "match": "::|\\."
            },
            {
              "name": "keyword.operator.wildcard.adac",
              "match": "\\*"
            },
            {
              "name": "entity.name.namespace.adac",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            }
          ]
        },
        {
          "comment": "import with string path: import \"file.adac\";",
          "match": "^\\s*(import)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.import.adac"
            }
          }
        }
      ]
    },
    "for-header": {
      "begin": "\\b(for)\\b\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.loop.adac"
        },
        "2": {
          "name": "punctuation.parenthesis.begin.adac"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.parenthesis.end.adac"
        }
      },
      "patterns": [
        {
          "name": "keyword.control.loop.range.adac",
          "match": "\\bto\\b"
        },
        {
          "name": "variable.language.placeholder.adac",
          "match": "\\b_\\b"
        },
        {
          "include": "$self"
        }
      ]
    },
    "class-declaration": {
      "match": "\\b(class|interface|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(<)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(>))?",
      "captures": {
        "1": {
          "name": "storage.type.class.adac"
        },
        "2": {
          "name": "entity.name.type.class.adac"
        },
        "3": {
          "name": "punctuation.definition.typeparameters.begin.adac"
        },
        "4": {
          "name": "entity.name.type.parameter.adac"
        },
        "5": {
          "name": "punctuation.definition.typeparameters.end.adac"
        }
      }
    },
    "builtin-functions": {
      "match": "\\b(print|println|printf|read|readInt|readFloat|readLine|len|toString|toInt|toFloat|sqrt|abs|min|max|pow|exit|setMen|freeMEM|sizeof)\\b(?=\\s*\\()",
      "name": "support.function.builtin.adac"
    },
    "intrinsics": {
      "match": "\\b__[A-Za-z0-9_]+\\b",
      "name": "support.function.intrinsic.adac"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.adac",
          "match": "\\b(if|else|switch|case|default)\\b"
        },
        {
          "name": "keyword.control.loop.adac",
          "match": "\\b(while|for|do|break|continue)\\b"
        },
        {
          "name": "keyword.control.flow.adac",
          "match": "\\b(return|throw)\\b"
        },
        {
          "name": "keyword.control.trycatch.adac",
          "match": "\\b(try|catch|finally)\\b"
        },
        {
          "name": "keyword.operator.new.adac",
          "match": "\\bnew\\b"
        },
        {
          "name": "keyword.operator.instanceof.adac",
          "match": "\\binstanceof\\b"
        },
        {
          "name": "storage.modifier.adac",
          "match": "\\b(public|private|protected|package|packege|static|abstract|extends|implements|const|var)\\b"
        },
        {
          "name": "variable.language.this.adac",
          "match": "\\b(this|super)\\b"
        },
        {
          "name": "storage.type.primitive.adac",
          "match": "\\b(int|long|float|double|bool|boolean|char|String|void|ptr)\\b"
        },
        {
          "name": "constant.language.boolean.adac",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.adac",
          "match": "\\bnull\\b"
        }
      ]
    },
    "library-types": {
      "match": "\\b(List|Map|Option|Result|Box|Rc|Stack|Queue|Set|StringBuilder|Math|Char|Int|Time|Fs|Exception|RuntimeException|Pc|Database|Db|Sqlite|DbTable|Web|WebApp|HttpRequest|Json|Ui|UiApp|UiElement|Utf8)\\b",
      "name": "support.class.adac"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.adac",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.adac",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.adac",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.adac",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.adac"
            },
            "2": {
              "name": "entity.name.function.member.adac"
            }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.adac"
            },
            "2": {
              "name": "variable.other.property.adac"
            }
          }
        }
      ]
    },
    "constants": {
      "match": "\\b[A-Z][A-Z0-9_]+\\b",
      "name": "constant.other.adac"
    },
    "types": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b(?!\\s*\\()",
      "name": "entity.name.type.adac"
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "name": "entity.name.function.adac"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.adac",
          "match": "<<=|>>=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^="
        },
        {
          "name": "keyword.operator.increment.adac",
          "match": "\\+\\+|--"
        },
        {
          "name": "keyword.operator.bitwise.shift.adac",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.comparison.adac",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.adac",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.adac",
          "match": "&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.arithmetic.adac",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.adac",
          "match": "="
        },
        {
          "name": "keyword.operator.ternary.adac",
          "match": "\\?|:"
        }
      ]
    }
  }
}
