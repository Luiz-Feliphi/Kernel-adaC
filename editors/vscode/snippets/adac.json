{
  "main function": { "prefix": "main", "body": ["void main() {", "\t$0", "}"], "description": "Program entry point" },
  "println": { "prefix": "pl", "body": "println($0);", "description": "Print a line" },
  "print": { "prefix": "pr", "body": "print($0);", "description": "Print without a newline" },
  "printf": { "prefix": "printf", "body": "printf(\"${1:%d}\\n\", ${2:value});", "description": "Formatted print" },
  "read int": { "prefix": "readint", "body": "int ${1:n} = read();", "description": "Read an integer from the console" },
  "read string": { "prefix": "readstr", "body": "String ${1:text} = read();", "description": "Read a line from the console" },
  "variable": { "prefix": "var", "body": "var ${1:name} = ${2:value};", "description": "Variable with inferred type" },
  "constant": { "prefix": "const", "body": "const ${1:NAME} = ${2:value};", "description": "Constant" },
  "if": { "prefix": "if", "body": ["if (${1:condition}) {", "\t$0", "}"], "description": "if statement" },
  "if else": { "prefix": "ifelse", "body": ["if (${1:condition}) {", "\t$2", "} else {", "\t$0", "}"], "description": "if / else" },
  "for to": { "prefix": "forto", "body": ["for (int ${1:i} = ${2:0} to ${3:10}; ${1:i}++) {", "\t$0", "}"], "description": "for loop with 'to' (inclusive)" },
  "for classic": { "prefix": "for", "body": ["for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {", "\t$0", "}"], "description": "Classic for loop" },
  "for declared": { "prefix": "forint", "body": ["for (int _; ${1:i} <= ${2:10}; ${1:i}++) {", "\t$0", "}"], "description": "for that declares its variable (int _)" },
  "for each": { "prefix": "foreach", "body": ["for (${1:int} ${2:item} : ${3:collection}) {", "\t$0", "}"], "description": "for-each over an array or List" },
  "while": { "prefix": "while", "body": ["while (${1:condition}) {", "\t$0", "}"], "description": "while loop" },
  "do while": { "prefix": "dowhile", "body": ["do {", "\t$0", "} while (${1:condition});"], "description": "do-while loop" },
  "switch": { "prefix": "switch", "body": ["switch (${1:value}) {", "\tcase ${2:1}:", "\t\t$3", "\t\tbreak;", "\tdefault:", "\t\t$0", "}"], "description": "switch statement" },
  "function": { "prefix": "fn", "body": ["${1:int} ${2:name}(${3:int a}) {", "\t$0", "}"], "description": "Function" },
  "class": { "prefix": "class", "body": ["public class ${1:Name} {", "\tprivate ${2:int} ${3:value};", "", "\tpublic ${1:Name}(${2:int} ${3:value}) {", "\t\tthis.${3:value} = ${3:value};", "\t}", "", "\t$0", "}"], "description": "Class with a constructor" },
  "class extends": { "prefix": "classext", "body": ["public class ${1:Child} extends ${2:Parent} {", "\tpublic ${1:Child}(${3}) {", "\t\tsuper(${4});", "\t}", "", "\t$0", "}"], "description": "Subclass" },
  "abstract class": { "prefix": "abstract", "body": ["abstract class ${1:Name} {", "\tabstract ${2:void} ${3:method}();", "\t$0", "}"], "description": "Abstract class" },
  "interface": { "prefix": "interface", "body": ["interface ${1:Name} {", "\t${2:void} ${3:method}();", "}"], "description": "Interface" },
  "implements": { "prefix": "impl", "body": ["class ${1:Name} implements ${2:Interface} {", "\tpublic ${3:void} ${4:method}() {", "\t\t$0", "\t}", "}"], "description": "Class implementing an interface" },
  "generic class": { "prefix": "generic", "body": ["class ${1:Box}<T> {", "\tT ${2:value};", "\t${1:Box}(T v) { ${2:value} = v; }", "\tT get() { return ${2:value}; }", "\t$0", "}"], "description": "Generic class (T is erased to a 64-bit word)" },
  "method": { "prefix": "method", "body": ["public ${1:void} ${2:name}(${3}) {", "\t$0", "}"], "description": "Method" },
  "static method": { "prefix": "static", "body": ["static ${1:int} ${2:name}(${3}) {", "\t$0", "}"], "description": "Static method" },
  "enum": { "prefix": "enum", "body": ["enum ${1:Name} { ${2:A}, ${3:B}, ${4:C} }"], "description": "Enumeration (ints with names)" },
  "try catch": { "prefix": "try", "body": ["try {", "\t$1", "} catch (${2:Exception} ${3:e}) {", "\t$0", "}"], "description": "try / catch" },
  "try catch finally": { "prefix": "tryf", "body": ["try {", "\t$1", "} catch (${2:Exception} ${3:e}) {", "\t$4", "} finally {", "\t$0", "}"], "description": "try / catch / finally" },
  "throw": { "prefix": "throw", "body": "throw new ${1:Exception}(\"${2:message}\");", "description": "Throw an exception" },
  "custom exception": { "prefix": "exception", "body": ["class ${1:MyError} extends Exception {", "\t${1:MyError}(String m) { super(m); }", "}"], "description": "Custom exception class" },
  "List": { "prefix": "list", "body": "List<${1:int}> ${2:items} = new List<${1:int}>();", "description": "List<T>" },
  "Map": { "prefix": "map", "body": "Map<String, ${1:int}> ${2:table} = new Map<String, ${1:int}>();", "description": "Map<String, V>" },
  "array": { "prefix": "array", "body": "${1:int}[] ${2:values} = new ${1:int}[${3:10}];", "description": "Array" },
  "array literal": { "prefix": "arrlit", "body": "${1:int}[] ${2:values} = {${3:1, 2, 3}};", "description": "Array literal" },
  "matrix": { "prefix": "matrix", "body": "${1:int}[][] ${2:grid} = new ${1:int}[${3:3}][${4:3}];", "description": "2-D array" },
  "use": { "prefix": "use", "body": "use std::${1:math};", "description": "Import a standard-library module" },
  "use collections": { "prefix": "usec", "body": "use std::collections::${1|Stack,Queue,Set|};", "description": "Import a collection" },
  "import": { "prefix": "import", "body": "import \"${1:file}.adac\";", "description": "Import another adaC file" },
  "manual memory": { "prefix": "manual", "body": "#NOT_GARBAGE", "description": "Turn the garbage collector off" },
  "strict": { "prefix": "strict", "body": "#STRICT", "description": "Assignments must be declared" },
  "package": { "prefix": "package", "body": "#definePackage: ${1:ClassA}, ${2:ClassB};", "description": "Export classes" },
  "malloc": { "prefix": "setmen", "body": ["${1:int}* ${2:p} = (${1:int}*) setMen(${3:10} * sizeof(${1:int}));", "$0", "freeMEM(${2:p});"], "description": "Manual allocation (needs #NOT_GARBAGE)" },
  "option": { "prefix": "option", "body": "Option<${1:int}> ${2:opt} = new Option<${1:int}>(${3:value});", "description": "Option<T> (use std::option)" },
  "result": { "prefix": "result", "body": ["Result<${1:int}> ${2:r} = new Result<${1:int}>();", "${2:r}.ok(${3:value});"], "description": "Result<T> (use std::result)" },
  "string builder": { "prefix": "sb", "body": ["StringBuilder ${1:sb} = new StringBuilder();", "${1:sb}.append(\"${2:text}\");", "String ${3:result} = ${1:sb}.toString();"], "description": "StringBuilder (use std::string_builder)" },
  "ternary": { "prefix": "tern", "body": "${1:condition} ? ${2:a} : ${3:b}", "description": "Conditional expression" },
  "region": { "prefix": "region", "body": ["// #region ${1:name}", "$0", "// #endregion"], "description": "Foldable region" }
}
