# ---- Compiler build output
/adac
/adac.exe
/build/
*.o
*.obj

# ---- Executables produced by adac (programs you compile)
*.exe
# ...except the prebuilt examples, so they can be downloaded from the repo
!/examples/bin/*.exe

# ---- Test and benchmark artifacts
/tests/out/
/benchmarks/*_o0
/benchmarks/*_o2
__pycache__/
*.pyc
adac_test_file.txt

# ---- Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- VS Code extension
/editors/vscode/node_modules/
*.vsix
