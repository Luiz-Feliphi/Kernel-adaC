// std::ui - Native modern UI framework for adaC (Win32 + fast DIB anti-aliased renderer + ClearType).
// Supports TWO styling modes:
//   1) Literal CSS rules: app.css("...") / app.loadCss("style.css")
//   2) Fluent inline code styling: btn.bg("#6366f1").hoverBg("#4f46e5").radius(12).paddingXY(20, 10).bold()
use std::fs;
use std::string_builder;

class _UiStyle {
    int bg;           bool hasBg;
    int bg2;          bool hasGrad;
    int hoverBg;      bool hasHoverBg;
    int activeBg;     bool hasActiveBg;
    int fg;           bool hasFg;
    int borderColor;  bool hasBorderColor;
    int borderWidth;  bool hasBorderWidth;
    int radius;       bool hasRadius;
    int padX;         int padY;        bool hasPad;
    int margin;       bool hasMargin;
    int gap;          bool hasGap;
    int width;        bool hasWidth;
    int height;       bool hasHeight;
    int fontSize;     bool hasFontSize;
    bool bold;        bool hasBold;
    String fontName;  bool hasFontName;
    int align;        bool hasAlign;
    int shadow;       bool hasShadow;
    bool isRow;       bool hasDir;
    int alignItems;   bool hasAlignItems;

    _UiStyle() {
        bg = 0; hasBg = false;
        bg2 = 0; hasGrad = false;
        hoverBg = 0; hasHoverBg = false;
        activeBg = 0; hasActiveBg = false;
        fg = 0xFFFFFF; hasFg = false;
        borderColor = 0; hasBorderColor = false;
        borderWidth = 0; hasBorderWidth = false;
        radius = 0; hasRadius = false;
        padX = 0; padY = 0; hasPad = false;
        margin = 0; hasMargin = false;
        gap = 8; hasGap = false;
        width = 0; hasWidth = false;
        height = 0; hasHeight = false;
        fontSize = 15; hasFontSize = false;
        bold = false; hasBold = false;
        fontName = "Segoe UI"; hasFontName = false;
        align = 0; hasAlign = false;
        shadow = 0; hasShadow = false;
        isRow = false; hasDir = false;
        alignItems = 0; hasAlignItems = false;
    }

    void copyFrom(_UiStyle s) {
        if (s.hasBg) { bg = s.bg; hasBg = true; }
        if (s.hasGrad) { bg2 = s.bg2; hasGrad = true; }
        if (s.hasHoverBg) { hoverBg = s.hoverBg; hasHoverBg = true; }
        if (s.hasActiveBg) { activeBg = s.activeBg; hasActiveBg = true; }
        if (s.hasFg) { fg = s.fg; hasFg = true; }
        if (s.hasBorderColor) { borderColor = s.borderColor; hasBorderColor = true; }
        if (s.hasBorderWidth) { borderWidth = s.borderWidth; hasBorderWidth = true; }
        if (s.hasRadius) { radius = s.radius; hasRadius = true; }
        if (s.hasPad) { padX = s.padX; padY = s.padY; hasPad = true; }
        if (s.hasMargin) { margin = s.margin; hasMargin = true; }
        if (s.hasGap) { gap = s.gap; hasGap = true; }
        if (s.hasWidth) { width = s.width; hasWidth = true; }
        if (s.hasHeight) { height = s.height; hasHeight = true; }
        if (s.hasFontSize) { fontSize = s.fontSize; hasFontSize = true; }
        if (s.hasBold) { bold = s.bold; hasBold = true; }
        if (s.hasFontName) { fontName = s.fontName; hasFontName = true; }
        if (s.hasAlign) { align = s.align; hasAlign = true; }
        if (s.hasShadow) { shadow = s.shadow; hasShadow = true; }
        if (s.hasDir) { isRow = s.isRow; hasDir = true; }
        if (s.hasAlignItems) { alignItems = s.alignItems; hasAlignItems = true; }
    }
}

class _CssRule {
    String selector;
    String pseudo;
    _UiStyle style;
    _CssRule(String sel, String ps, _UiStyle st) { selector = sel; pseudo = ps; style = st; }
}

class _UiColor {
    static int _hexVal(char c) {
        if (c >= '0' && c <= '9') return (int) c - 48;
        if (c >= 'a' && c <= 'f') return (int) c - 87;
        if (c >= 'A' && c <= 'F') return (int) c - 55;
        return 0;
    }

    static int _parseNum(String s) {
        String t = s.trim();
        int n = 0;
        for (int i = 0; i < t.length(); i++) {
            char c = t[i];
            if (c >= '0' && c <= '9') n = n * 10 + ((int) c - 48);
            else if (n > 0) break;
        }
        return n;
    }

    static int parse(String raw) {
        if (raw == null) return 0xFF000000;
        String s = raw.trim().toLowerCase();
        if (s.equals("transparent") || s.equals("none")) return 0;
        if (s.equals("white")) return 0xFFFFFFFF;
        if (s.equals("black")) return 0xFF000000;
        if (s.equals("red")) return 0xFFEF4444;
        if (s.equals("green")) return 0xFF22C55E;
        if (s.equals("blue")) return 0xFF3B82F6;
        if (s.equals("indigo")) return 0xFF6366F1;
        if (s.equals("purple")) return 0xFFA855F7;
        if (s.equals("pink")) return 0xFFEC4899;
        if (s.equals("cyan")) return 0xFF06B6D4;
        if (s.equals("amber") || s.equals("yellow")) return 0xFFF59E0B;
        if (s.equals("gray") || s.equals("grey")) return 0xFF71717A;
        if (s.startsWith("#")) {
            String h = s.substring(1, s.length());
            if (h.length() == 3) {
                int r = _hexVal(h[0]) * 17;
                int g = _hexVal(h[1]) * 17;
                int b = _hexVal(h[2]) * 17;
                return (255 << 24) | (r << 16) | (g << 8) | b;
            }
            if (h.length() >= 6) {
                int r = (_hexVal(h[0]) << 4) | _hexVal(h[1]);
                int g = (_hexVal(h[2]) << 4) | _hexVal(h[3]);
                int b = (_hexVal(h[4]) << 4) | _hexVal(h[5]);
                int a = 255;
                if (h.length() >= 8) a = (_hexVal(h[6]) << 4) | _hexVal(h[7]);
                return (a << 24) | (r << 16) | (g << 8) | b;
            }
        }
        if (s.startsWith("rgb(") || s.startsWith("rgba(")) {
            int lp = s.indexOf("(");
            int rp = s.indexOf(")");
            if (lp >= 0 && rp > lp) {
                String[] parts = s.substring(lp + 1, rp).split(",");
                int r = parts.length > 0 ? _parseNum(parts[0]) : 0;
                int g = parts.length > 1 ? _parseNum(parts[1]) : 0;
                int b = parts.length > 2 ? _parseNum(parts[2]) : 0;
                return (255 << 24) | ((r & 255) << 16) | ((g & 255) << 8) | (b & 255);
            }
        }
        return 0xFF000000;
    }

    static int px(String raw) { return _parseNum(raw); }
}

class _CssEngine {
    List<_CssRule> rules;

    _CssEngine() { rules = new List<_CssRule>(); }

    private void _applyProp(_UiStyle st, String key, String val) {
        String k = key.trim().toLowerCase();
        String v = val.trim();
        if (k.equals("background-color") || k.equals("background")) {
            String vl = v.toLowerCase();
            if (vl.startsWith("linear-gradient(")) {
                int lp = v.indexOf("(");
                int rp = v.indexOf(")");
                if (lp >= 0 && rp > lp) {
                    String[] parts = v.substring(lp + 1, rp).split(",");
                    if (parts.length >= 3) {
                        st.bg = _UiColor.parse(parts[1]); st.hasBg = true;
                        st.bg2 = _UiColor.parse(parts[2]); st.hasGrad = true;
                    } else if (parts.length == 2) {
                        st.bg = _UiColor.parse(parts[0]); st.hasBg = true;
                        st.bg2 = _UiColor.parse(parts[1]); st.hasGrad = true;
                    }
                }
            } else {
                st.bg = _UiColor.parse(v); st.hasBg = true; st.hasGrad = false;
            }
        } else if (k.equals("color")) {
            st.fg = _UiColor.parse(v); st.hasFg = true;
        } else if (k.equals("border-radius")) {
            st.radius = _UiColor.px(v); st.hasRadius = true;
        } else if (k.equals("border-color")) {
            st.borderColor = _UiColor.parse(v); st.hasBorderColor = true;
        } else if (k.equals("border-width")) {
            st.borderWidth = _UiColor.px(v); st.hasBorderWidth = true;
        } else if (k.equals("border")) {
            String[] ps = v.split(" ");
            for (int i = 0; i < ps.length; i++) {
                String t = ps[i].trim();
                if (t.length() == 0) continue;
                if (t.endsWith("px") || (t[0] >= '0' && t[0] <= '9')) { st.borderWidth = _UiColor.px(t); st.hasBorderWidth = true; }
                else if (t.startsWith("#") || t.startsWith("rgb")) { st.borderColor = _UiColor.parse(t); st.hasBorderColor = true; }
            }
        } else if (k.equals("padding")) {
            String[] ps = v.split(" ");
            List<String> nums = new List<String>();
            for (int i = 0; i < ps.length; i++) if (ps[i].trim().length() > 0) nums.add(ps[i].trim());
            if (nums.size() == 1) { st.padY = _UiColor.px(nums[0]); st.padX = st.padY; st.hasPad = true; }
            else if (nums.size() >= 2) { st.padY = _UiColor.px(nums[0]); st.padX = _UiColor.px(nums[1]); st.hasPad = true; }
        } else if (k.equals("margin")) {
            st.margin = _UiColor.px(v); st.hasMargin = true;
        } else if (k.equals("gap")) {
            st.gap = _UiColor.px(v); st.hasGap = true;
        } else if (k.equals("width")) {
            st.width = _UiColor.px(v); st.hasWidth = true;
        } else if (k.equals("height")) {
            st.height = _UiColor.px(v); st.hasHeight = true;
        } else if (k.equals("font-size")) {
            st.fontSize = _UiColor.px(v); st.hasFontSize = true;
        } else if (k.equals("font-weight")) {
            String vl = v.toLowerCase();
            st.bold = vl.equals("bold") || vl.equals("700") || vl.equals("600") || vl.equals("800");
            st.hasBold = true;
        } else if (k.equals("font-family")) {
            st.fontName = v.replace("'", "").replace("\"", "").trim();
            st.hasFontName = true;
        } else if (k.equals("text-align")) {
            String vl = v.toLowerCase();
            if (vl.equals("center")) st.align = 1;
            else if (vl.equals("right")) st.align = 2;
            else st.align = 0;
            st.hasAlign = true;
        } else if (k.equals("box-shadow")) {
            if (v.toLowerCase().equals("none")) { st.shadow = 0; st.hasShadow = true; }
            else {
                String[] ps = v.split(" ");
                int maxP = 8;
                for (int i = 0; i < ps.length; i++) {
                    String t = ps[i].trim();
                    if (t.length() > 0 && (t[0] >= '0' && t[0] <= '9')) {
                        int pv = _UiColor.px(t);
                        if (pv > maxP) maxP = pv;
                    }
                }
                st.shadow = maxP; st.hasShadow = true;
            }
        } else if (k.equals("flex-direction")) {
            st.isRow = v.toLowerCase().equals("row"); st.hasDir = true;
        } else if (k.equals("align-items")) {
            String vl = v.toLowerCase();
            if (vl.equals("center")) st.alignItems = 1;
            else if (vl.equals("end") || vl.equals("flex-end")) st.alignItems = 2;
            else st.alignItems = 0;
            st.hasAlignItems = true;
        }
    }

    void parse(String cssText) {
        if (cssText == null) return;
        int n = cssText.length();
        int i = 0;
        while (i < n) {
            while (i < n && cssText[i] != '{') {
                if (cssText[i] == '/' && i + 1 < n && cssText[i + 1] == '*') {
                    i += 2;
                    while (i + 1 < n && !(cssText[i] == '*' && cssText[i + 1] == '/')) i++;
                    i += 2;
                    continue;
                }
                break;
            }
            int startSel = i;
            while (i < n && cssText[i] != '{') i++;
            if (i >= n) break;
            String selRaw = cssText.substring(startSel, i).trim();
            i++;
            int startBody = i;
            while (i < n && cssText[i] != '}') i++;
            String body = cssText.substring(startBody, i);
            if (i < n) i++;

            _UiStyle st = new _UiStyle();
            String[] decls = body.split(";");
            for (int d = 0; d < decls.length; d++) {
                String decl = decls[d].trim();
                int col = decl.indexOf(":");
                if (col > 0) _applyProp(st, decl.substring(0, col), decl.substring(col + 1, decl.length()));
            }

            String[] sels = selRaw.split(",");
            for (int s = 0; s < sels.length; s++) {
                String one = sels[s].trim();
                if (one.length() == 0) continue;
                String pseudo = "";
                int pcol = one.indexOf(":");
                if (pcol > 0) {
                    pseudo = one.substring(pcol + 1, one.length()).trim().toLowerCase();
                    one = one.substring(0, pcol).trim();
                }
                rules.add(new _CssRule(one, pseudo, st));
            }
        }
    }

    void resolve(String tag, String clsStr, String idStr, bool hovered, bool active, bool focused, _UiStyle out) {
        for (int i = 0; i < rules.size(); i++) {
            _CssRule r = rules[i];
            if (r.pseudo.equals("") && r.selector.equals(tag)) out.copyFrom(r.style);
        }
        if (clsStr != null && clsStr.length() > 0) {
            String[] clss = clsStr.split(" ");
            for (int c = 0; c < clss.length; c++) {
                String cn = clss[c].trim();
                if (cn.length() == 0) continue;
                String dot = "." + cn;
                for (int i = 0; i < rules.size(); i++) {
                    _CssRule r = rules[i];
                    if (r.pseudo.equals("") && r.selector.equals(dot)) out.copyFrom(r.style);
                }
            }
        }
        if (idStr != null && idStr.length() > 0) {
            String hash = "#" + idStr;
            for (int i = 0; i < rules.size(); i++) {
                _CssRule r = rules[i];
                if (r.pseudo.equals("") && r.selector.equals(hash)) out.copyFrom(r.style);
            }
        }
        if (hovered) {
            for (int i = 0; i < rules.size(); i++) {
                _CssRule r = rules[i];
                if (r.pseudo.equals("hover") && _matchSel(r.selector, tag, clsStr, idStr)) out.copyFrom(r.style);
            }
        }
        if (active) {
            for (int i = 0; i < rules.size(); i++) {
                _CssRule r = rules[i];
                if (r.pseudo.equals("active") && _matchSel(r.selector, tag, clsStr, idStr)) out.copyFrom(r.style);
            }
        }
        if (focused) {
            for (int i = 0; i < rules.size(); i++) {
                _CssRule r = rules[i];
                if (r.pseudo.equals("focus") && _matchSel(r.selector, tag, clsStr, idStr)) out.copyFrom(r.style);
            }
        }
    }

    private bool _matchSel(String sel, String tag, String clsStr, String idStr) {
        if (sel.equals(tag)) return true;
        if (idStr != null && idStr.length() > 0 && sel.equals("#" + idStr)) return true;
        if (clsStr != null && clsStr.length() > 0 && sel.startsWith(".")) {
            String target = sel.substring(1, sel.length());
            String[] clss = clsStr.split(" ");
            for (int i = 0; i < clss.length; i++) if (clss[i].trim().equals(target)) return true;
        }
        return false;
    }
}

class UiElement {
    String tag;
    String clsName;
    String idName;
    String _text;
    String _placeholder;
    bool _checked;
    int _value;
    _UiStyle inlineStyle;
    List<UiElement> children;
    _CssEngine _css;

    int rx; int ry; int rw; int rh;
    bool hovered;
    bool pressed;
    bool focused;
    bool _clicked;
    bool _changed;
    bool _submitted;
    bool _dirty;

    UiElement(String t, _CssEngine cssEngine) {
        tag = t;
        clsName = "";
        idName = "";
        _text = "";
        _placeholder = "";
        _checked = false;
        _value = 0;
        inlineStyle = new _UiStyle();
        children = new List<UiElement>();
        _css = cssEngine;
        rx = 0; ry = 0; rw = 0; rh = 0;
        hovered = false; pressed = false; focused = false;
        _clicked = false; _changed = false; _submitted = false;
        _dirty = true;
        _initDefaults(t);
    }

    private void _initDefaults(String t) {
        if (t.equals("window")) {
            inlineStyle.bg = 0xFF09090B; inlineStyle.hasBg = true;
            inlineStyle.padX = 24; inlineStyle.padY = 24; inlineStyle.hasPad = true;
            inlineStyle.gap = 14; inlineStyle.hasGap = true;
        } else if (t.equals("card")) {
            inlineStyle.bg = 0xFF18181B; inlineStyle.hasBg = true;
            inlineStyle.borderColor = 0xFF27272A; inlineStyle.hasBorderColor = true;
            inlineStyle.borderWidth = 1; inlineStyle.hasBorderWidth = true;
            inlineStyle.radius = 16; inlineStyle.hasRadius = true;
            inlineStyle.padX = 20; inlineStyle.padY = 20; inlineStyle.hasPad = true;
            inlineStyle.gap = 12; inlineStyle.hasGap = true;
            inlineStyle.shadow = 12; inlineStyle.hasShadow = true;
        } else if (t.equals("row")) {
            inlineStyle.isRow = true; inlineStyle.hasDir = true;
            inlineStyle.gap = 12; inlineStyle.hasGap = true;
        } else if (t.equals("column")) {
            inlineStyle.gap = 10; inlineStyle.hasGap = true;
        } else if (t.equals("title")) {
            inlineStyle.fontSize = 24; inlineStyle.hasFontSize = true;
            inlineStyle.bold = true; inlineStyle.hasBold = true;
            inlineStyle.fg = 0xFFFAFAFA; inlineStyle.hasFg = true;
        } else if (t.equals("label")) {
            inlineStyle.fontSize = 15; inlineStyle.hasFontSize = true;
            inlineStyle.fg = 0xFFE4E4E7; inlineStyle.hasFg = true;
        } else if (t.equals("button")) {
            inlineStyle.bg = 0xFF6366F1; inlineStyle.hasBg = true;
            inlineStyle.hoverBg = 0xFF4F46E5; inlineStyle.hasHoverBg = true;
            inlineStyle.activeBg = 0xFF4338CA; inlineStyle.hasActiveBg = true;
            inlineStyle.fg = 0xFFFFFFFF; inlineStyle.hasFg = true;
            inlineStyle.radius = 10; inlineStyle.hasRadius = true;
            inlineStyle.padX = 20; inlineStyle.padY = 10; inlineStyle.hasPad = true;
            inlineStyle.bold = true; inlineStyle.hasBold = true;
            inlineStyle.align = 1; inlineStyle.hasAlign = true;
            inlineStyle.shadow = 6; inlineStyle.hasShadow = true;
        } else if (t.equals("input")) {
            inlineStyle.bg = 0xFF18181B; inlineStyle.hasBg = true;
            inlineStyle.borderColor = 0xFF3F3F46; inlineStyle.hasBorderColor = true;
            inlineStyle.borderWidth = 1; inlineStyle.hasBorderWidth = true;
            inlineStyle.fg = 0xFFFAFAFA; inlineStyle.hasFg = true;
            inlineStyle.radius = 10; inlineStyle.hasRadius = true;
            inlineStyle.padX = 14; inlineStyle.padY = 10; inlineStyle.hasPad = true;
            inlineStyle.width = 280; inlineStyle.hasWidth = true;
        } else if (t.equals("badge")) {
            inlineStyle.bg = 0xFF27272A; inlineStyle.hasBg = true;
            inlineStyle.fg = 0xFFA5B4FC; inlineStyle.hasFg = true;
            inlineStyle.radius = 999; inlineStyle.hasRadius = true;
            inlineStyle.padX = 12; inlineStyle.padY = 4; inlineStyle.hasPad = true;
            inlineStyle.fontSize = 12; inlineStyle.hasFontSize = true;
            inlineStyle.bold = true; inlineStyle.hasBold = true;
        } else if (t.equals("progress")) {
            inlineStyle.bg = 0xFF27272A; inlineStyle.hasBg = true;
            inlineStyle.bg2 = 0xFF6366F1; inlineStyle.hasGrad = true;
            inlineStyle.radius = 999; inlineStyle.hasRadius = true;
            inlineStyle.height = 10; inlineStyle.hasHeight = true;
            inlineStyle.width = 280; inlineStyle.hasWidth = true;
        } else if (t.equals("toggle")) {
            inlineStyle.fg = 0xFFE4E4E7; inlineStyle.hasFg = true;
            inlineStyle.bg = 0xFF6366F1; inlineStyle.hasBg = true;
        } else if (t.equals("divider")) {
            inlineStyle.bg = 0xFF27272A; inlineStyle.hasBg = true;
            inlineStyle.height = 1; inlineStyle.hasHeight = true;
        }
    }

    UiElement add(UiElement child) { children.add(child); _dirty = true; return this; }
    UiElement card() { UiElement e = new UiElement("card", _css); children.add(e); return e; }
    UiElement row() { UiElement e = new UiElement("row", _css); children.add(e); return e; }
    UiElement column() { UiElement e = new UiElement("column", _css); children.add(e); return e; }
    UiElement title(String t) { UiElement e = new UiElement("title", _css); e._text = t; children.add(e); return e; }
    UiElement label(String t) { UiElement e = new UiElement("label", _css); e._text = t; children.add(e); return e; }
    UiElement button(String t) { UiElement e = new UiElement("button", _css); e._text = t; children.add(e); return e; }
    UiElement input(String placeholder) { UiElement e = new UiElement("input", _css); e._placeholder = placeholder; children.add(e); return e; }
    UiElement toggle(String labelText, bool initial) { UiElement e = new UiElement("toggle", _css); e._text = labelText; e._checked = initial; children.add(e); return e; }
    UiElement badge(String t) { UiElement e = new UiElement("badge", _css); e._text = t; children.add(e); return e; }
    UiElement progress(int percent) { UiElement e = new UiElement("progress", _css); e._value = percent; children.add(e); return e; }
    UiElement divider() { UiElement e = new UiElement("divider", _css); children.add(e); return e; }
    UiElement spacer(int px) { UiElement e = new UiElement("spacer", _css); e.inlineStyle.width = px; e.inlineStyle.height = px; e.inlineStyle.hasWidth = true; e.inlineStyle.hasHeight = true; children.add(e); return e; }

    UiElement cls(String c) { clsName = c; _dirty = true; return this; }
    UiElement id(String i) { idName = i; _dirty = true; return this; }

    UiElement bg(String c) { inlineStyle.bg = _UiColor.parse(c); inlineStyle.hasBg = true; inlineStyle.hasGrad = false; _dirty = true; return this; }
    UiElement gradient(String c1, String c2) { inlineStyle.bg = _UiColor.parse(c1); inlineStyle.bg2 = _UiColor.parse(c2); inlineStyle.hasBg = true; inlineStyle.hasGrad = true; _dirty = true; return this; }
    UiElement hoverBg(String c) { inlineStyle.hoverBg = _UiColor.parse(c); inlineStyle.hasHoverBg = true; return this; }
    UiElement activeBg(String c) { inlineStyle.activeBg = _UiColor.parse(c); inlineStyle.hasActiveBg = true; return this; }
    UiElement color(String c) { inlineStyle.fg = _UiColor.parse(c); inlineStyle.hasFg = true; _dirty = true; return this; }
    UiElement radius(int r) { inlineStyle.radius = r; inlineStyle.hasRadius = true; _dirty = true; return this; }
    UiElement border(String c, int w) { inlineStyle.borderColor = _UiColor.parse(c); inlineStyle.borderWidth = w; inlineStyle.hasBorderColor = true; inlineStyle.hasBorderWidth = true; _dirty = true; return this; }
    UiElement border(int w) { if (!inlineStyle.hasBorderColor) { inlineStyle.borderColor = 0xFF3F3F46; inlineStyle.hasBorderColor = true; } inlineStyle.borderWidth = w; inlineStyle.hasBorderWidth = true; _dirty = true; return this; }
    UiElement padding(int p) { inlineStyle.padX = p; inlineStyle.padY = p; inlineStyle.hasPad = true; _dirty = true; return this; }
    UiElement paddingXY(int px, int py) { inlineStyle.padX = px; inlineStyle.padY = py; inlineStyle.hasPad = true; _dirty = true; return this; }
    UiElement margin(int m) { inlineStyle.margin = m; inlineStyle.hasMargin = true; _dirty = true; return this; }
    UiElement gap(int g) { inlineStyle.gap = g; inlineStyle.hasGap = true; _dirty = true; return this; }
    UiElement width(int w) { inlineStyle.width = w; inlineStyle.hasWidth = true; _dirty = true; return this; }
    UiElement height(int h) { inlineStyle.height = h; inlineStyle.hasHeight = true; _dirty = true; return this; }
    UiElement size(int w, int h) { inlineStyle.width = w; inlineStyle.height = h; inlineStyle.hasWidth = true; inlineStyle.hasHeight = true; _dirty = true; return this; }
    UiElement fontSize(int sz) { inlineStyle.fontSize = sz; inlineStyle.hasFontSize = true; _dirty = true; return this; }
    UiElement bold() { inlineStyle.bold = true; inlineStyle.hasBold = true; _dirty = true; return this; }
    UiElement font(String name) { inlineStyle.fontName = name; inlineStyle.hasFontName = true; _dirty = true; return this; }
    UiElement align(String a) {
        String al = a.toLowerCase();
        if (al.equals("center")) inlineStyle.align = 1;
        else if (al.equals("right")) inlineStyle.align = 2;
        else inlineStyle.align = 0;
        inlineStyle.hasAlign = true;
        _dirty = true;
        return this;
    }
    UiElement shadow(int s) { inlineStyle.shadow = s; inlineStyle.hasShadow = true; _dirty = true; return this; }
    UiElement asRow() { inlineStyle.isRow = true; inlineStyle.hasDir = true; _dirty = true; return this; }
    UiElement asColumn() { inlineStyle.isRow = false; inlineStyle.hasDir = true; _dirty = true; return this; }
    UiElement center() { inlineStyle.alignItems = 1; inlineStyle.hasAlignItems = true; _dirty = true; return this; }

    String text() { return _text; }
    UiElement setText(String t) { if (!_text.equals(t)) { _text = t; _dirty = true; } return this; }
    bool checked() { return _checked; }
    UiElement setChecked(bool b) { if (_checked != b) { _checked = b; _dirty = true; } return this; }
    int value() { return _value; }
    UiElement setValue(int v) { if (v < 0) v = 0; if (v > 100) v = 100; if (_value != v) { _value = v; _dirty = true; } return this; }
    bool clicked() { bool r = _clicked; _clicked = false; return r; }
    bool changed() { bool r = _changed; _changed = false; return r; }
    bool submitted() { bool r = _submitted; _submitted = false; return r; }

    _UiStyle computeStyle() {
        _UiStyle s = new _UiStyle();
        s.copyFrom(inlineStyle);
        _css.resolve(tag, clsName, idName, hovered, pressed, focused, s);
        if (hovered && inlineStyle.hasHoverBg && !pressed) { s.bg = inlineStyle.hoverBg; s.hasBg = true; s.hasGrad = false; }
        if (pressed && inlineStyle.hasActiveBg) { s.bg = inlineStyle.activeBg; s.hasBg = true; s.hasGrad = false; }
        return s;
    }
}

class UiApp {
    int _u32; int _g32; int _k32; int _dwm;
    int _hwnd;
    int _w; int _h;
    int _memDC; int _bmp; int _bits;
    int _bufW; int _bufH;
    _CssEngine _css;
    UiElement root;
    UiElement _focused;
    bool _prevDown;
    int _scrollY;
    bool _needPaint;
    int _lastW; int _lastH;

    // Cached Win32 function pointers
    int _fIsWin; int _fPeek; int _fTrans; int _fDisp;
    int _fRect; int _fCur; int _fS2C; int _fKey;
    int _fGetDC; int _fRelDC; int _fDrawText;
    int _fBitBlt; int _fSel; int _fDelObj; int _fCreateFont;
    int _fBk; int _fTc; int _fExt;

    // Reusable scratch buffers (zero per-frame alloc)
    int _msgBuf; int _rcBuf; int _ptBuf; int _szBuf;
    Map<String, int> _fonts;

    UiApp(String titleStr, int w, int h) {
        _u32 = __winapi(14, (int) "user32.dll");
        _g32 = __winapi(14, (int) "gdi32.dll");
        _k32 = __winapi(14, (int) "kernel32.dll");
        _dwm = __winapi(14, (int) "dwmapi.dll");
        _w = w; _h = h;
        _bufW = 0; _bufH = 0; _memDC = 0; _bmp = 0; _bits = 0;
        _css = new _CssEngine();
        root = new UiElement("window", _css);
        _focused = null;
        _prevDown = false;
        _scrollY = 0;
        _needPaint = true;
        _lastW = 0; _lastH = 0;

        _fIsWin = __winapi(15, _u32, (int) "IsWindow");
        _fPeek = __winapi(15, _u32, (int) "PeekMessageA");
        _fTrans = __winapi(15, _u32, (int) "TranslateMessage");
        _fDisp = __winapi(15, _u32, (int) "DispatchMessageA");
        _fRect = __winapi(15, _u32, (int) "GetClientRect");
        _fCur = __winapi(15, _u32, (int) "GetCursorPos");
        _fS2C = __winapi(15, _u32, (int) "ScreenToClient");
        _fKey = __winapi(15, _u32, (int) "GetAsyncKeyState");
        _fGetDC = __winapi(15, _u32, (int) "GetDC");
        _fRelDC = __winapi(15, _u32, (int) "ReleaseDC");
        _fDrawText = __winapi(15, _u32, (int) "DrawTextA");
        _fBitBlt = __winapi(15, _g32, (int) "BitBlt");
        _fSel = __winapi(15, _g32, (int) "SelectObject");
        _fDelObj = __winapi(15, _g32, (int) "DeleteObject");
        _fCreateFont = __winapi(15, _g32, (int) "CreateFontA");
        _fBk = __winapi(15, _g32, (int) "SetBkMode");
        _fTc = __winapi(15, _g32, (int) "SetTextColor");
        _fExt = __winapi(15, _g32, (int) "GetTextExtentPoint32A");

        _msgBuf = __alloc_atomic(48);
        _rcBuf = __alloc_atomic(16);
        _ptBuf = __alloc_atomic(8);
        _szBuf = __alloc_atomic(8);
        _fonts = new Map<String, int>();

        _createWindow(titleStr, w, h);
    }

    private void _poke16(int a, int v) { __poke8(a, v & 255); __poke8(a + 1, (v >> 8) & 255); }
    private void _poke32(int a, int v) {
        __poke8(a, v & 255); __poke8(a + 1, (v >> 8) & 255);
        __poke8(a + 2, (v >> 16) & 255); __poke8(a + 3, (v >> 24) & 255);
    }
    private int _peek32s(int a) {
        int v = __peek8(a) | (__peek8(a + 1) << 8) | (__peek8(a + 2) << 16) | (__peek8(a + 3) << 24);
        if ((v & 0x80000000) != 0) return v | (-1 << 32);
        return v;
    }

    private void _createWindow(String titleStr, int w, int h) {
        int fGetMod = __winapi(15, _k32, (int) "GetModuleHandleA");
        int fDefProc = __winapi(15, _u32, (int) "DefWindowProcA");
        int fLoadCur = __winapi(15, _u32, (int) "LoadCursorA");
        int fReg = __winapi(15, _u32, (int) "RegisterClassExA");
        int fCreate = __winapi(15, _u32, (int) "CreateWindowExA");
        int fShow = __winapi(15, _u32, (int) "ShowWindow");
        int fUpd = __winapi(15, _u32, (int) "UpdateWindow");

        int hInst = __call(fGetMod, 0);
        int curArrow = __call(fLoadCur, 0, 32512);
        String clsName = "AdaCUiWindowClass";

        int wc = __alloc_atomic(80);
        _poke32(wc + 0, 80);
        _poke32(wc + 4, 3);
        __poke64(wc + 8, fDefProc);
        __poke64(wc + 24, hInst);
        __poke64(wc + 40, curArrow);
        __poke64(wc + 64, (int) clsName);
        __call(fReg, wc);

        _hwnd = __call(fCreate, 0, (int) clsName, (int) titleStr, 0x00CF0000, 0x80000000, 0x80000000, w, h, 0, 0, hInst, 0);

        if (_dwm != 0 && _hwnd != 0) {
            int fDwm = __winapi(15, _dwm, (int) "DwmSetWindowAttribute");
            if (fDwm != 0) {
                int dark = __alloc_atomic(4);
                _poke32(dark, 1);
                __call(fDwm, _hwnd, 20, dark, 4);
            }
        }
        if (_hwnd != 0) {
            __call(fShow, _hwnd, 5);
            __call(fUpd, _hwnd);
        }
    }

    UiApp css(String cssRules) { _css.parse(cssRules); _needPaint = true; return this; }
    UiApp loadCss(String filePath) {
        if (Fs.exists(filePath)) {
            String txt = Fs.readToString(filePath);
            if (txt != null) { _css.parse(txt); _needPaint = true; }
        }
        return this;
    }

    UiElement card() { _needPaint = true; return root.card(); }
    UiElement row() { _needPaint = true; return root.row(); }
    UiElement column() { _needPaint = true; return root.column(); }
    UiElement title(String t) { _needPaint = true; return root.title(t); }
    UiElement label(String t) { _needPaint = true; return root.label(t); }
    UiElement button(String t) { _needPaint = true; return root.button(t); }
    UiElement input(String ph) { _needPaint = true; return root.input(ph); }
    UiElement toggle(String l, bool init) { _needPaint = true; return root.toggle(l, init); }
    UiElement badge(String t) { _needPaint = true; return root.badge(t); }
    UiElement progress(int pct) { _needPaint = true; return root.progress(pct); }
    UiElement divider() { _needPaint = true; return root.divider(); }
    UiElement spacer(int px) { _needPaint = true; return root.spacer(px); }

    private void _ensureBuffer(int w, int h) {
        if (w <= 0) w = 1;
        if (h <= 0) h = 1;
        if (_memDC != 0 && _bufW == w && _bufH == h) return;
        int fDelDC = __winapi(15, _g32, (int) "DeleteDC");
        if (_bmp != 0) __call(_fDelObj, _bmp);
        if (_memDC != 0) __call(fDelDC, _memDC);

        int fCompDC = __winapi(15, _g32, (int) "CreateCompatibleDC");
        int fDIB = __winapi(15, _g32, (int) "CreateDIBSection");
        int hdc = __call(_fGetDC, _hwnd);
        _memDC = __call(fCompDC, hdc);
        int bmi = __alloc_atomic(44);
        _poke32(bmi + 0, 40);
        _poke32(bmi + 4, w);
        _poke32(bmi + 8, 0 - h);
        _poke16(bmi + 12, 1);
        _poke16(bmi + 14, 32);
        int pBits = __alloc_atomic(8);
        _bmp = __call(fDIB, _memDC, bmi, 0, pBits, 0, 0);
        _bits = __peek64(pBits);
        __call(_fSel, _memDC, _bmp);
        __call(_fRelDC, _hwnd, hdc);
        _bufW = w; _bufH = h;
    }

    // ---- Ultra-fast span & pixel primitives ----
    private void _fillSpanOpaque(int y, int x0, int x1, int rgb) {
        if (y < 0 || y >= _bufH) return;
        if (x0 < 0) x0 = 0;
        if (x1 > _bufW) x1 = _bufW;
        if (x0 >= x1) return;
        int col = rgb & 0x00FFFFFF;
        int col2 = col | (col << 32);
        int addr = _bits + (y * _bufW + x0) * 4;
        int cnt = x1 - x0;
        while (cnt >= 2) {
            __poke64(addr, col2);
            addr = addr + 8;
            cnt = cnt - 2;
        }
        if (cnt == 1) _poke32(addr, col);
    }

    private void _fillSpanAlpha(int y, int x0, int x1, int argb) {
        if (y < 0 || y >= _bufH) return;
        if (x0 < 0) x0 = 0;
        if (x1 > _bufW) x1 = _bufW;
        if (x0 >= x1) return;
        int a = (argb >> 24) & 255;
        if (a == 0) return;
        if (a == 255) { _fillSpanOpaque(y, x0, x1, argb); return; }
        int sr = (argb >> 16) & 255;
        int sg = (argb >> 8) & 255;
        int sb = argb & 255;
        int ia = 255 - a;
        int addr = _bits + (y * _bufW + x0) * 4;
        int end = _bits + (y * _bufW + x1) * 4;
        while (addr < end) {
            int dst = _peek32s(addr);
            int rr = (sr * a + ((dst >> 16) & 255) * ia) / 255;
            int rg = (sg * a + ((dst >> 8) & 255) * ia) / 255;
            int rb = (sb * a + (dst & 255) * ia) / 255;
            _poke32(addr, (rr << 16) | (rg << 8) | rb);
            addr = addr + 4;
        }
    }

    private void _blendPixel(int x, int y, int argb) {
        if (x < 0 || y < 0 || x >= _bufW || y >= _bufH) return;
        int a = (argb >> 24) & 255;
        if (a == 0) return;
        int addr = _bits + (y * _bufW + x) * 4;
        if (a == 255) { _poke32(addr, argb & 0x00FFFFFF); return; }
        int dst = _peek32s(addr);
        int ia = 255 - a;
        int rr = (((argb >> 16) & 255) * a + ((dst >> 16) & 255) * ia) / 255;
        int rg = (((argb >> 8) & 255) * a + ((dst >> 8) & 255) * ia) / 255;
        int rb = ((argb & 255) * a + (dst & 255) * ia) / 255;
        _poke32(addr, (rr << 16) | (rg << 8) | rb);
    }

    private int _lerpColor(int c1, int c2, int t, int maxT) {
        if (maxT <= 0) return c1;
        int a1 = (c1 >> 24) & 255; int r1 = (c1 >> 16) & 255; int g1 = (c1 >> 8) & 255; int b1 = c1 & 255;
        int a2 = (c2 >> 24) & 255; int r2 = (c2 >> 16) & 255; int g2 = (c2 >> 8) & 255; int b2 = c2 & 255;
        int a = a1 + (a2 - a1) * t / maxT;
        int r = r1 + (r2 - r1) * t / maxT;
        int g = g1 + (g2 - g1) * t / maxT;
        int b = b1 + (b2 - b1) * t / maxT;
        return (a << 24) | (r << 16) | (g << 8) | b;
    }

    private int _isqrt(int n) {
        if (n <= 0) return 0;
        int x = n;
        int y = (x + 1) / 2;
        while (y < x) { x = y; y = (x + n / x) / 2; }
        return x;
    }

    // Fast anti-aliased rounded rectangle: flat spans for interior, AA only on corners!
    private void _drawRoundRect(int x, int y, int w, int h, int rad, int c1, int c2, bool grad, int bColor, int bWidth) {
        if (w <= 0 || h <= 0) return;
        int maxR = (w < h ? w : h) / 2;
        if (rad > maxR) rad = maxR;
        if (rad < 0) rad = 0;

        int x0 = x < 0 ? 0 : x;
        int y0 = y < 0 ? 0 : y;
        int x1 = x + w > _bufW ? _bufW : x + w;
        int y1 = y + h > _bufH ? _bufH : y + h;

        // Fast path: sharp solid rectangle (e.g. window background, dividers)
        if (rad == 0 && !grad && bWidth == 0) {
            for (int py = y0; py < y1; py++) _fillSpanAlpha(py, x0, x1, c1);
            return;
        }

        int rInner = rad - bWidth;
        if (rInner < 0) rInner = 0;
        int outer = rad * 16;

        for (int py = y0; py < y1; py++) {
            int ly = py - y;
            int dy = 0;
            if (ly < rad) dy = rad - ly - 1;
            else if (ly >= h - rad) dy = ly - (h - rad);

            // Middle rows (no corner curvature): fast spans!
            if (dy == 0 && !grad) {
                if (bWidth == 0) {
                    _fillSpanAlpha(py, x0, x1, c1);
                } else if (ly < bWidth || ly >= h - bWidth) {
                    _fillSpanAlpha(py, x0, x1, bColor);
                } else {
                    _fillSpanAlpha(py, x, x + bWidth, bColor);
                    _fillSpanAlpha(py, x + bWidth, x + w - bWidth, c1);
                    _fillSpanAlpha(py, x + w - bWidth, x + w, bColor);
                }
                continue;
            }

            // Corner rows or gradient: flat span for the middle [rad .. w-rad), AA only for corners!
            int midL = x + rad;
            int midR = x + w - rad;
            if (!grad && midR > midL) {
                if (bWidth > 0 && (ly < bWidth || ly >= h - bWidth)) _fillSpanAlpha(py, midL, midR, bColor);
                else _fillSpanAlpha(py, midL, midR, c1);
            }

            // Left corner + right corner (or full row if grad)
            int rxStart = grad ? x0 : x0;
            int rxEnd = grad ? x1 : (midL < x1 ? midL : x1);
            for (int px = rxStart; px < rxEnd; px++) {
                int lx = px - x;
                int dx = 0;
                if (lx < rad) dx = rad - lx - 1;
                else if (lx >= w - rad) dx = lx - (w - rad);
                int col = grad ? _lerpColor(c1, c2, lx, w) : c1;
                if (dx == 0 && dy == 0) {
                    if (bWidth > 0 && (lx < bWidth || lx >= w - bWidth || ly < bWidth || ly >= h - bWidth)) _blendPixel(px, py, bColor);
                    else _blendPixel(px, py, col);
                    continue;
                }
                int dist = _isqrt((dx * 16 + 8) * (dx * 16 + 8) + (dy * 16 + 8) * (dy * 16 + 8));
                if (dist >= outer + 12) continue;
                int cov = 255;
                if (dist > outer - 12) {
                    cov = (outer + 12 - dist) * 255 / 24;
                    if (cov < 0) cov = 0;
                    if (cov > 255) cov = 255;
                }
                int drawCol = col;
                if (bWidth > 0 && dist >= rInner * 16 - 8) drawCol = bColor;
                int ca = ((drawCol >> 24) & 255) * cov / 255;
                if (ca > 0) _blendPixel(px, py, (ca << 24) | (drawCol & 0x00FFFFFF));
            }
            if (!grad) {
                int rStart = midR > x0 ? midR : x0;
                for (int px = rStart; px < x1; px++) {
                    int lx = px - x;
                    int dx = lx - (w - rad);
                    if (dx < 0) dx = 0;
                    int dist = _isqrt((dx * 16 + 8) * (dx * 16 + 8) + (dy * 16 + 8) * (dy * 16 + 8));
                    if (dist >= outer + 12) continue;
                    int cov = 255;
                    if (dist > outer - 12) {
                        cov = (outer + 12 - dist) * 255 / 24;
                        if (cov < 0) cov = 0;
                        if (cov > 255) cov = 255;
                    }
                    int drawCol = c1;
                    if (bWidth > 0 && dist >= rInner * 16 - 8) drawCol = bColor;
                    int ca = ((drawCol >> 24) & 255) * cov / 255;
                    if (ca > 0) _blendPixel(px, py, (ca << 24) | (drawCol & 0x00FFFFFF));
                }
            }
        }
    }

    // Fast outer shadow: only draws the outer shadow halo (skips interior covered by card)
    private void _drawShadow(int x, int y, int w, int h, int rad, int blur) {
        if (blur <= 0) return;
        int pad = blur / 2;
        if (pad < 3) pad = 3;
        _drawRoundRect(x - pad / 2, y + pad, w + pad, h + pad, rad + 2, 0x24000000, 0, false, 0, 0);
        _drawRoundRect(x - 1, y + 2, w + 2, h + 2, rad + 1, 0x20000000, 0, false, 0, 0);
    }

    // ---- Cached ClearType Fonts ----
    private int _getFont(int sz, bool isBold, String name) {
        String key = name + ":" + sz + ":" + (isBold ? "1" : "0");
        if (_fonts.has(key)) return _fonts.get(key);
        int wt = isBold ? 700 : 400;
        int f = __call(_fCreateFont, 0 - sz, 0, 0, 0, wt, 0, 0, 0, 1, 0, 0, 5, 0, (int) name);
        _fonts.put(key, f);
        return f;
    }

    private int _measureW(String txt, int sz, bool isBold, String fname) {
        if (txt == null || txt.length() == 0) return 0;
        int font = _getFont(sz, isBold, fname);
        int old = __call(_fSel, _memDC, font);
        __call(_fExt, _memDC, (int) txt, __strlen(txt), _szBuf);
        __call(_fSel, _memDC, old);
        return _peek32s(_szBuf);
    }

    private void _drawText(String txt, int x, int y, int w, int h, _UiStyle st) {
        if (txt == null || txt.length() == 0) return;
        int font = _getFont(st.fontSize, st.bold, st.fontName);
        int old = __call(_fSel, _memDC, font);
        __call(_fBk, _memDC, 1);
        int rgb = st.fg & 0x00FFFFFF;
        int bgr = ((rgb & 0xFF) << 16) | (rgb & 0xFF00) | ((rgb >> 16) & 0xFF);
        __call(_fTc, _memDC, bgr);

        _poke32(_rcBuf + 0, x); _poke32(_rcBuf + 4, y);
        _poke32(_rcBuf + 8, x + w); _poke32(_rcBuf + 12, y + h);
        int flags = 0x20 | 0x04 | 0x800;
        if (st.align == 1) flags = flags | 1;
        else if (st.align == 2) flags = flags | 2;
        __call(_fDrawText, _memDC, (int) txt, __strlen(txt), _rcBuf, flags);
        __call(_fSel, _memDC, old);
    }

    // ---- Layout Engine ----
    private void _measure(UiElement el, int availW) {
        _UiStyle st = el.computeStyle();
        int padX = st.padX;
        int padY = st.padY;
        if (el.tag.equals("title") || el.tag.equals("label") || el.tag.equals("button") || el.tag.equals("badge")) {
            int tw = _measureW(el._text, st.fontSize, st.bold, st.fontName);
            el.rw = st.hasWidth ? st.width : (tw + padX * 2);
            el.rh = st.hasHeight ? st.height : (st.fontSize + 8 + padY * 2);
            return;
        }
        if (el.tag.equals("input")) {
            el.rw = st.hasWidth ? st.width : 280;
            el.rh = st.hasHeight ? st.height : (st.fontSize + 8 + padY * 2);
            return;
        }
        if (el.tag.equals("toggle")) {
            int tw = _measureW(el._text, st.fontSize, st.bold, st.fontName);
            el.rw = st.hasWidth ? st.width : (48 + 10 + tw);
            el.rh = st.hasHeight ? st.height : 28;
            return;
        }
        if (el.tag.equals("progress")) {
            el.rw = st.hasWidth ? st.width : 280;
            el.rh = st.hasHeight ? st.height : 10;
            return;
        }
        if (el.tag.equals("divider")) {
            el.rw = st.hasWidth ? st.width : availW;
            el.rh = st.hasHeight ? st.height : 1;
            return;
        }
        if (el.tag.equals("spacer")) {
            el.rw = st.width; el.rh = st.height;
            return;
        }

        int innerW = (st.hasWidth ? st.width : availW) - padX * 2;
        if (innerW < 0) innerW = 0;
        int sumMain = 0;
        int maxCross = 0;
        for (int i = 0; i < el.children.size(); i++) {
            UiElement ch = el.children[i];
            _measure(ch, innerW);
            _UiStyle cst = ch.computeStyle();
            int m = cst.margin * 2;
            if (st.isRow) {
                sumMain = sumMain + ch.rw + m;
                if (i > 0) sumMain = sumMain + st.gap;
                if (ch.rh + m > maxCross) maxCross = ch.rh + m;
            } else {
                sumMain = sumMain + ch.rh + m;
                if (i > 0) sumMain = sumMain + st.gap;
                if (ch.rw + m > maxCross) maxCross = ch.rw + m;
            }
        }
        if (st.hasWidth) el.rw = st.width;
        else if (el.tag.equals("window")) el.rw = availW;
        else if (el.tag.equals("card") || el.tag.equals("column")) el.rw = maxCross + padX * 2 > availW ? availW : (el.tag.equals("card") ? availW : maxCross + padX * 2);
        else el.rw = (st.isRow ? sumMain : maxCross) + padX * 2;

        if (st.hasHeight) el.rh = st.height;
        else el.rh = (st.isRow ? maxCross : sumMain) + padY * 2;
    }

    private void _layout(UiElement el, int x, int y) {
        el.rx = x; el.ry = y;
        _UiStyle st = el.computeStyle();
        int cx = x + st.padX;
        int cy = y + st.padY;
        for (int i = 0; i < el.children.size(); i++) {
            UiElement ch = el.children[i];
            _UiStyle cst = ch.computeStyle();
            int m = cst.margin;
            if (st.isRow) {
                int oy = cy + m;
                if (st.alignItems == 1) oy = y + (el.rh - ch.rh) / 2;
                _layout(ch, cx + m, oy);
                cx = cx + ch.rw + m * 2 + st.gap;
            } else {
                int ox = cx + m;
                if (st.alignItems == 1) ox = x + (el.rw - ch.rw) / 2;
                _layout(ch, ox, cy + m);
                cy = cy + ch.rh + m * 2 + st.gap;
            }
        }
    }

    private void _paint(UiElement el) {
        _UiStyle st = el.computeStyle();
        if (el.tag.equals("spacer")) return;

        if (el.tag.equals("toggle")) {
            int trackCol = el._checked ? (st.hasBg ? st.bg : 0xFF6366F1) : 0xFF3F3F46;
            _drawRoundRect(el.rx, el.ry + 2, 46, 24, 12, trackCol, 0, false, 0, 0);
            int knobX = el._checked ? el.rx + 24 : el.rx + 3;
            _drawRoundRect(knobX, el.ry + 5, 18, 18, 9, 0xFFFFFFFF, 0, false, 0, 0);
            _drawText(el._text, el.rx + 56, el.ry, el.rw - 56, el.rh, st);
            return;
        }

        if (el.tag.equals("progress")) {
            _drawRoundRect(el.rx, el.ry, el.rw, el.rh, st.radius, st.bg, 0, false, 0, 0);
            int fw = el.rw * el._value / 100;
            if (fw > 0) _drawRoundRect(el.rx, el.ry, fw, el.rh, st.radius, st.bg2, 0xFFA855F7, true, 0, 0);
            return;
        }

        if (st.shadow > 0) _drawShadow(el.rx, el.ry, el.rw, el.rh, st.radius, st.shadow);
        if (st.hasBg || st.hasBorderWidth) {
            _drawRoundRect(el.rx, el.ry, el.rw, el.rh, st.radius, st.bg, st.bg2, st.hasGrad, st.borderColor, st.borderWidth);
        }

        if (el.tag.equals("input")) {
            String show = el._text.length() > 0 ? el._text : el._placeholder;
            if (el._text.length() == 0 && !el.focused) {
                _UiStyle phSt = new _UiStyle();
                phSt.copyFrom(st);
                phSt.fg = 0xFF71717A;
                _drawText(show, el.rx + st.padX, el.ry, el.rw - st.padX * 2, el.rh, phSt);
            } else {
                String txt = el.focused ? (el._text + "|") : el._text;
                _drawText(txt, el.rx + st.padX, el.ry, el.rw - st.padX * 2, el.rh, st);
            }
            if (el.focused) {
                _drawRoundRect(el.rx, el.ry, el.rw, el.rh, st.radius, 0, 0, false, 0xFF6366F1, 2);
            }
            return;
        }

        if (el._text.length() > 0 && (el.tag.equals("title") || el.tag.equals("label") || el.tag.equals("button") || el.tag.equals("badge"))) {
            int tx = st.align == 1 ? el.rx : el.rx + st.padX;
            int tw = st.align == 1 ? el.rw : el.rw - st.padX * 2;
            _drawText(el._text, tx, el.ry, tw, el.rh, st);
        }

        for (int i = 0; i < el.children.size(); i++) _paint(el.children[i]);
    }

    private bool _hitTest(UiElement el, int mx, int my, bool down, bool released) {
        bool changed = false;
        bool inside = mx >= el.rx && mx < el.rx + el.rw && my >= el.ry && my < el.ry + el.rh;
        if (el.hovered != inside) {
            el.hovered = inside;
            if (el.tag.equals("button") || el.tag.equals("toggle") || el.tag.equals("input")) changed = true;
        }
        if (el.tag.equals("button") || el.tag.equals("input") || el.tag.equals("toggle")) {
            if (inside && down && !_prevDown) { el.pressed = true; changed = true; }
            if (released) {
                if (inside && el.pressed) {
                    if (el.tag.equals("button")) el._clicked = true;
                    else if (el.tag.equals("toggle")) { el._checked = !el._checked; el._changed = true; }
                    else if (el.tag.equals("input")) {
                        if (_focused != null && _focused != el) _focused.focused = false;
                        el.focused = true;
                        _focused = el;
                    }
                    changed = true;
                }
                if (el.pressed) { el.pressed = false; changed = true; }
            }
        }
        if (released && !inside && el.tag.equals("input") && el.focused) {
            el.focused = false;
            if (_focused == el) _focused = null;
            changed = true;
        }
        for (int i = 0; i < el.children.size(); i++) {
            if (_hitTest(el.children[i], mx, my, down, released)) changed = true;
        }
        return changed;
    }

    private bool _anyDirty(UiElement el) {
        if (el._dirty) { el._dirty = false; return true; }
        for (int i = 0; i < el.children.size(); i++) {
            if (_anyDirty(el.children[i])) return true;
        }
        return false;
    }

    // ---- Event Loop (call in `while (app.loop())`) ----
    bool loop() {
        if (__call(_fIsWin, _hwnd) == 0) return false;

        bool hadInput = false;
        while (__call(_fPeek, _msgBuf, 0, 0, 0, 1) != 0) {
            int mtype = _peek32s(_msgBuf + 8);
            if (mtype == 0x0102 && _focused != null) { // WM_CHAR
                int ch = __peek64(_msgBuf + 16) & 0xFF;
                if (ch == 8) {
                    int ln = _focused._text.length();
                    if (ln > 0) { _focused._text = _focused._text.substring(0, ln - 1); _focused._changed = true; _needPaint = true; }
                } else if (ch == 13) {
                    _focused._submitted = true; _needPaint = true;
                } else if (ch >= 32 && ch < 127) {
                    int tmp = __alloc_atomic(2);
                    __poke8(tmp, ch);
                    _focused._text = _focused._text + __str_from(tmp, 1);
                    _focused._changed = true;
                    _needPaint = true;
                }
                hadInput = true;
            } else if (mtype == 0x020A) { // WM_MOUSEWHEEL
                int delta = (_peek32s(_msgBuf + 16) >> 16);
                _scrollY = _scrollY + (delta > 0 ? 30 : -30);
                if (_scrollY > 0) _scrollY = 0;
                _needPaint = true;
                hadInput = true;
            } else if (mtype == 0x000F) { // WM_PAINT
                _needPaint = true;
            }
            __call(_fTrans, _msgBuf);
            __call(_fDisp, _msgBuf);
        }
        if (__call(_fIsWin, _hwnd) == 0) return false;

        __call(_fRect, _hwnd, _rcBuf);
        int cw = _peek32s(_rcBuf + 8);
        int ch = _peek32s(_rcBuf + 12);
        if (cw <= 0) cw = _w;
        if (ch <= 0) ch = _h;
        if (cw != _lastW || ch != _lastH) { _lastW = cw; _lastH = ch; _needPaint = true; }

        __call(_fCur, _ptBuf);
        __call(_fS2C, _hwnd, _ptBuf);
        int mx = _peek32s(_ptBuf);
        int my = _peek32s(_ptBuf + 4);
        bool down = (__call(_fKey, 1) & 0x8000) != 0;
        bool released = _prevDown && !down;

        if (_hitTest(root, mx, my, down, released)) _needPaint = true;
        _prevDown = down;

        if (_anyDirty(root)) _needPaint = true;

        if (_needPaint) {
            _ensureBuffer(cw, ch);
            _measure(root, cw);
            if (root.rh < ch) root.rh = ch;
            _layout(root, 0, _scrollY);
            _paint(root);
            int hdc = __call(_fGetDC, _hwnd);
            __call(_fBitBlt, hdc, 0, 0, cw, ch, _memDC, 0, 0, 0x00CC0020);
            __call(_fRelDC, _hwnd, hdc);
            _needPaint = false;
        }

        if (!hadInput) __winapi(9, 8);
        return true;
    }
}

class Ui {
    static UiApp window(String title, int width, int height) {
        return new UiApp(title, width, height);
    }
}
